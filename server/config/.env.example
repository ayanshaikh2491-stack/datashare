# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Headscale (Open Source Tailscale Alternative)
HEADSCALE_URL=http://localhost:8080
HEADSCALE_API_KEY=your-headscale-api-key
HEADSCALE_NAMESPACE=datashare

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Connection Settings
MAX_CONNECTIONS_PER_DONOR=3
DEFAULT_DATA_LIMIT_MB=500
DEFAULT_SESSION_TIME_MIN=60
DEFAULT_DAILY_TOTAL_GB=5
MAX_RECEIVERS_PER_DAY=5
MAX_DATA_PER_RECEIVER_MB=2048
CONNECTION_COOLDOWN_SEC=600

# Logging
LOG_LEVEL=debug
